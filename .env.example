# =================================================================
# Lisa - Autonomous AI Companion & Holographic 3D Avatar
# Environment Configuration Template
# =================================================================

# Choose your Primary LLM Provider: "gemini", "groq", "ollama", or "openrouter"
LLM_PROVIDER=gemini

# -----------------------------------------------------------------
# Option 1: Google Gemini (Recommended - Free Tier Available)
# Get key: https://aistudio.google.com/
# -----------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------
# Option 2: Groq (Ultra-Fast Inference)
# Get key: https://console.groq.com/
# -----------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------
# Option 3: Ollama (100% Free, Private & Local)
# Run: `ollama run llama3.2` or `ollama run qwen2.5`
# -----------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# -----------------------------------------------------------------
# Option 4: OpenRouter (Multi-Model Gateway)
# Get key: https://openrouter.ai/
# -----------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# -----------------------------------------------------------------
# ElevenLabs TTS Integration (Optional - Natural Cloud Voice)
# Default is free Microsoft Edge TTS (no key required)
# -----------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# -----------------------------------------------------------------
# Telegram Bot Integration (Optional)
# Create a bot via @BotFather on Telegram
# -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# -----------------------------------------------------------------
# Twilio Voice Calling Integration (Optional)
# Get credentials: https://www.twilio.com/console
# -----------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
USER_PHONE_NUMBER=+1234567890
